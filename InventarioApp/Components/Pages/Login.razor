@page "/login"
@inject ApiClient Api
@inject SessionService Sesion
@inject NavigationManager Nav

<PageTitle>Ingresar</PageTitle>

<div class="login-box">
    <h1>Ingresar</h1>

    <div class="campo">
        <label for="usuario">Usuario</label>
        <input id="usuario" @bind="_usuario" autocomplete="username" />
    </div>

    <div class="campo">
        <label for="password">Contraseña</label>
        <input id="password" type="password" @bind="_password" autocomplete="current-password"
               @onkeydown="OnKeyDown" />
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error">@_error</div>
    }

    <button class="btn-principal" @onclick="IngresarAsync" disabled="@_cargando">
        @(_cargando ? "Ingresando..." : "Ingresar")
    </button>

    <p class="aparte">¿No tenés cuenta? <a href="/registro">Registrate</a></p>
    <p class="aparte"><a href="/">Ver catálogo sin ingresar</a></p>
</div>

<style>
    .login-box {
        max-width: 380px;
        margin: 2rem auto;
        padding: 1.5rem;
        border: 1px solid #ddd;
        border-radius: 12px;
    }

    .campo {
        margin-bottom: 1rem;
        display: flex;
        flex-direction: column;
    }

        .campo label {
            font-weight: 600;
            margin-bottom: .25rem;
        }

        .campo input {
            padding: .6rem;
            border: 1px solid #bbb;
            border-radius: 8px;
            font-size: 1rem;
        }

    .error {
        background: #fde8e8;
        color: #b00020;
        padding: .6rem;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .btn-principal {
        width: 100%;
        padding: .7rem;
        border: none;
        border-radius: 8px;
        background: #1a73e8;
        color: #fff;
        font-size: 1rem;
        cursor: pointer;
    }

        .btn-principal:disabled {
            opacity: .6;
        }

    .aparte {
        text-align: center;
        margin-top: 1rem;
    }
</style>

@code {
    private string _usuario = "";
    private string _password = "";
    private string? _error;
    private bool _cargando;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await IngresarAsync();
    }

    private async Task IngresarAsync()
    {
        if (_cargando) return;

        if (string.IsNullOrWhiteSpace(_usuario) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Completá usuario y contraseña.";
            return;
        }

        _error = null;
        _cargando = true;

        var r = await Api.LoginAsync(_usuario.Trim(), _password);

        _cargando = false;

        if (r.Ok)
            Nav.NavigateTo("/", forceLoad: false);
        else
            _error = r.Error;
    }
}