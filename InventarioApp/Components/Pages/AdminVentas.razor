@page "/admin/ventas"
@inject ApiClient Api
@inject SessionService Sesion

<PageTitle>Ventas de mostrador</PageTitle>

<h1>Ventas de mostrador</h1>

@if (!Sesion.EsPersonal)
{
    <div class="error">Esta sección es solo para Admin y Vendedor.</div>
}
else
{
    @if (_aviso is not null) { <div class="aviso">@_aviso</div> }
    @if (_error is not null) { <div class="error">@_error</div> }

    <div class="form">
        <h2>Nueva venta</h2>

        <div class="campo">
            <label>Cliente *</label>
            <select @bind="_clienteId">
                <option value="0">Seleccionar...</option>
                @foreach (var c in _clientes)
                {
                    <option value="@c.Id">@c.Nombre@(string.IsNullOrEmpty(c.DNI) ? "" : $" (DNI {c.DNI})")</option>
                }
            </select>
        </div>

        <div class="campo">
            <label>Buscar producto para agregar</label>
            <div class="fila">
                <input placeholder="Nombre del producto..." @bind="_buscar" @bind:event="oninput" @onkeydown="OnKeyDown" />
                <button class="btn-sec" @onclick="BuscarProductosAsync">Buscar</button>
            </div>
        </div>

        @if (_buscando)
        {
            <p class="nota">Buscando...</p>
        }
        else if (_sugerencias.Count > 0)
        {
            <div class="sugerencias">
                @foreach (var p in _sugerencias)
                {
                    <div class="sug">
                        <span>@p.Nombre <span class="nota">($ @p.Precio.ToString("N2") · stock @p.Stock)</span></span>
                        <button class="btn-sec" disabled="@p.SinStock" @onclick="() => AgregarLinea(p)">
                            @(p.SinStock ? "Sin stock" : "Agregar")
                        </button>
                    </div>
                }
            </div>
        }

        @if (_lineas.Count > 0)
        {
            <h3>Productos de la venta</h3>
            @foreach (var l in _lineas)
            {
                <div class="linea">
                    <div class="info">
                        <strong>@l.Producto.Nombre</strong>
                        <div class="nota">$ @l.Producto.Precio.ToString("N2") c/u · stock @l.Producto.Stock</div>
                    </div>
                    <div class="campo mini">
                        <label>Cantidad</label>
                        <input type="number" min="1" max="@l.Producto.Stock" @bind="l.Cantidad" />
                    </div>
                    <div class="sub">$ @l.Subtotal.ToString("N2")</div>
                    <button class="quitar" @onclick="() => _lineas.Remove(l)">✕</button>
                </div>
            }
            <p class="total">Total estimado: $ @_lineas.Sum(x => x.Subtotal).ToString("N2")</p>
            <p class="nota">El precio final lo define el servidor al registrar.</p>
        }

        <button class="btn-principal" @onclick="GuardarAsync" disabled="@_guardando">
            @(_guardando ? "Registrando..." : "Registrar venta")
        </button>
    </div>

    <h2>Historial</h2>

    @if (_cargando)
    {
        <p class="nota">Cargando...</p>
    }
    else if (_salidas.Count == 0)
    {
        <p class="nota">Todavía no hay ventas registradas.</p>
    }
    else
    {
        @foreach (var s in _salidas.OrderByDescending(x => x.Fecha))
        {
            <div class="compra">
                <div class="compra-cab" @onclick="() => Alternar(s.Id)">
                    <div>
                        <strong>Venta N° @s.Id</strong> · @s.ClienteNombre
                        <div class="nota">@s.Fecha.ToString("dd/MM/yyyy HH:mm") · @s.UsuarioNombre</div>
                    </div>
                    <div><strong>$ @s.Total.ToString("N2")</strong> @(_abierto == s.Id ? "▲" : "▼")</div>
                </div>
                @if (_abierto == s.Id)
                {
                    <ul class="det">
                        @foreach (var d in s.Detalles)
                        {
                            <li>@d.Cantidad × @d.ProductoNombre — $ @d.PrecioUnitario.ToString("N2") c/u</li>
                        }
                    </ul>
                }
            </div>
        }
    }
}

<style>
    .error { background: #fde8e8; color: #b00020; padding: .6rem; border-radius: 8px; margin-bottom: 1rem; }
    .aviso { background: #e6f4ea; color: #137333; padding: .6rem; border-radius: 8px; margin-bottom: 1rem; }
    .nota { color: #777; font-size: .85rem; }
    .form { border: 1px solid #ddd; border-radius: 12px; padding: 1rem; margin-bottom: 1.5rem; background: #fafafa; max-width: 640px; }
    .campo { display: flex; flex-direction: column; margin-bottom: .75rem; flex: 1; }
    .campo.mini { max-width: 110px; margin-bottom: 0; }
    .campo label { font-weight: 600; margin-bottom: .25rem; font-size: .85rem; }
    .campo input, .campo select { padding: .5rem; border: 1px solid #bbb; border-radius: 8px; font-size: 1rem; }
    .fila { display: flex; gap: .5rem; }
    .fila input { flex: 1; padding: .5rem; border: 1px solid #bbb; border-radius: 8px; }
    .sugerencias { border: 1px solid #ddd; border-radius: 8px; background: #fff; margin-bottom: .75rem; max-height: 220px; overflow-y: auto; }
    .sug { display: flex; justify-content: space-between; align-items: center; padding: .5rem .75rem; border-bottom: 1px solid #eee; }
    .linea { display: flex; align-items: flex-end; gap: .5rem; padding: .5rem 0; border-bottom: 1px solid #eee; flex-wrap: wrap; }
    .linea .info { flex: 1; min-width: 120px; }
    .sub { min-width: 90px; text-align: right; font-weight: 600; }
    .quitar { border: none; background: transparent; color: #b00020; cursor: pointer; font-size: 1.1rem; }
    .total { font-size: 1.2rem; font-weight: 700; margin: 1rem 0 .25rem; }
    .btn-principal { padding: .6rem 1.1rem; border: none; border-radius: 8px; background: #1a73e8; color: #fff; cursor: pointer; margin-top: .5rem; }
    .btn-principal:disabled { opacity: .6; }
    .btn-sec { padding: .5rem 1rem; border: 1px solid #bbb; border-radius: 8px; background: #fff; cursor: pointer; }
    .btn-sec:disabled { opacity: .5; }
    .compra { border: 1px solid #e0e0e0; border-radius: 12px; margin-bottom: .75rem; overflow: hidden; }
    .compra-cab { display: flex; justify-content: space-between; align-items: center; padding: .8rem 1rem; cursor: pointer; background: #fafafa; }
    .det { margin: .5rem 1rem; }
</style>

@code {
    private List<ClienteDto> _clientes = new();
    private List<SalidaDto> _salidas = new();
    private List<ProductoDto> _sugerencias = new();
    private readonly List<LineaVenta> _lineas = new();
    private int _clienteId;
    private string _buscar = "";
    private string? _error;
    private string? _aviso;
    private bool _cargando;
    private bool _buscando;
    private bool _guardando;
    private int _abierto;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EsPersonal) return;

        var cl = await Api.GetClientesAsync();
        if (cl.Ok && cl.Data is not null) _clientes = cl.Data;
        else _error = cl.Error;

        await CargarSalidasAsync();
    }

    private async Task CargarSalidasAsync()
    {
        _cargando = true;
        StateHasChanged();

        var r = await Api.GetSalidasAsync();
        _cargando = false;

        if (r.Ok && r.Data is not null) _salidas = r.Data;
        else _error = r.Error;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarProductosAsync();
    }

    private async Task BuscarProductosAsync()
    {
        _buscando = true;
        StateHasChanged();

        var r = await Api.GetProductosAsync(new FiltroProductos
        {
            Buscar = _buscar,
            TamanioPagina = 8
        });

        _buscando = false;
        if (r.Ok && r.Data is not null) _sugerencias = r.Data.Items;
        else _error = r.Error;
    }

    private void AgregarLinea(ProductoDto p)
    {
        var existente = _lineas.FirstOrDefault(l => l.Producto.Id == p.Id);
        if (existente is not null)
        {
            if (existente.Cantidad < p.Stock) existente.Cantidad++;
            return;
        }

        _lineas.Add(new LineaVenta { Producto = p, Cantidad = 1 });
    }

    private void Alternar(int id) => _abierto = _abierto == id ? 0 : id;

    private async Task GuardarAsync()
    {
        if (_guardando) return;
        _error = null;
        _aviso = null;

        if (_clienteId <= 0)
        {
            _error = "Elegí un cliente.";
            return;
        }
        if (_lineas.Count == 0)
        {
            _error = "Agregá al menos un producto.";
            return;
        }
        if (_lineas.Any(l => l.Cantidad <= 0))
        {
            _error = "Todas las cantidades deben ser mayores a 0.";
            return;
        }

        _guardando = true;

        var dto = new SalidaCreateDto
        {
            ClienteId = _clienteId,
            Detalles = _lineas.Select(l => new SalidaDetalleCreateDto
            {
                ProductoId = l.Producto.Id,
                Cantidad = l.Cantidad,
                PrecioUnitario = l.Producto.Precio // la API lo ignora y usa el precio del producto
            }).ToList()
        };

        var r = await Api.CrearSalidaAsync(dto);
        _guardando = false;

        if (r.Ok)
        {
            _aviso = "Venta registrada: el stock se descontó.";
            _lineas.Clear();
            _sugerencias = new();
            _buscar = "";
            _clienteId = 0;
            await CargarSalidasAsync();
        }
        else
        {
            _error = r.Error;
        }
    }
}